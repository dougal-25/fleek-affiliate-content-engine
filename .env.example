# Real values live in the dwcw workspace root .env, never here and never in code.
# `content_brain/engine_io.load_env()` walks up from the package to find it.

# Optional — without it the engine runs in deterministic mock mode
ANTHROPIC_API_KEY=sk-ant-...

# Required by scripts/run_brief_job.py — writes briefs back to the Creators table
AIRTABLE_API_KEY=pat...

# Required to publish a creator's brief as a shareable Notion page
NOTION_API_KEY=ntn_...

# The Notion page the briefs are created under. Create one page ("Fleek — Creator Briefs"),
# share it with the integration, then copy the 32-char id out of its URL.
# Its share settings are inherited by every brief page; the engine never makes a page public.
NOTION_BRIEFS_PAGE_ID=
