.venv/
__pycache__/
*.pyc
.env

# Scrape artifacts. The raw payloads are ~14MB of platform JSON and stay out; the DERIVED files are
# small and are exactly the "AI receipts" the task brief asks for (scrape input -> enrichment
# output -> scored cards), so they are committed and the spec pages cite them by path.
# Git does not descend into an ignored directory, hence the explicit directory re-includes.
data/**
!data/*/
!data/*/*/
!data/**/features.json
!data/**/creators.json
!data/**/audience*.json
!data/**/comments_normalised.json
!data/**/README.md

# macOS
.DS_Store

# Obsidian per-machine UI state (the vault's shared config IS committed)
Fleek Wiki/.obsidian/workspace.json
Fleek Wiki/.obsidian/graph.json
Fleek Wiki/.obsidian/appearance.json

# Obsidian sometimes creates a vault folder INSIDE this vault (a ".obsidian/"
# with no notes beside it). Two vaults then claim the same files and each
# writes its own settings — Obsidian advises against it. Never commit one.
# If one appears on disk, delete it and reopen Obsidian on "Fleek Wiki/" itself.
Fleek Wiki/*/.obsidian/

# Raw Claude Code transcripts are the source for deliverables/evidence/, but they
# are UNSCRUBBED and must never enter this repo — it is public. They live outside
# the working tree at ~/claude-transcript-archive/fleek-2026-07-10/ and are read
# from there by scripts/extract_receipts.py. This line is a backstop, not the control.
_evidence_raw/

# Playwright MCP byproduct — screenshots of our own UI mid-iteration, never source.
.playwright-mcp/
.vercel/
